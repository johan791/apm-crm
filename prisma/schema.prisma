generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  name                 String
  passwordHash         String     @map("password_hash")
  role                 String     @default("user")
  responsibleCustomers Customer[]
  responsibleProjects  Project[]
  activities           Activity[] @relation("CreatedActivities")
  assignedActivities   Activity[] @relation("AssignedActivities")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Customer {
  id                String          @id @default(cuid())
  companyName       String          @map("company_name")
  orgNumber         String?         @map("org_number")
  contactPerson     String?         @map("contact_person")
  email             String?
  phone             String?
  address           String?
  city              String?
  zipCode           String?         @map("zip_code")
  notes             String?
  onedriveFolderUrl String?         @map("onedrive_folder_url")
  responsibleUser   User?           @relation(fields: [responsibleUserId], references: [id])
  responsibleUserId String?         @map("responsible_user_id")
  contacts          Contact[]
  projects          Project[]
  quotes            Quote[]
  activities        Activity[]
  deliveryEvents    DeliveryEvent[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@map("customers")
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  role       String?
  email      String?
  phone      String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("contacts")
}

model Project {
  id                String           @id @default(cuid())
  name              String
  description       String?
  status            String           @default("active")
  hourlyRate        Decimal?         @map("hourly_rate") @db.Decimal(10, 2)
  startDate         DateTime?        @map("start_date")
  endDate           DateTime?        @map("end_date")
  customer          Customer         @relation(fields: [customerId], references: [id])
  customerId        String           @map("customer_id")
  responsibleUser   User?            @relation(fields: [responsibleUserId], references: [id])
  responsibleUserId String?          @map("responsible_user_id")
  partners          ProjectPartner[]
  timeEntries       TimeEntry[]
  quotes            Quote[]
  activities        Activity[]
  deliveryEvents    DeliveryEvent[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("projects")
}

model TimeEntry {
  id          String   @id @default(cuid())
  date        DateTime
  hours       Decimal  @db.Decimal(5, 2)
  description String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("time_entries")
}

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   Int         @unique @map("quote_number")
  status        String      @default("draft")
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerId    String      @map("customer_id")
  project       Project?    @relation(fields: [projectId], references: [id])
  projectId     String?     @map("project_id")
  validUntil    DateTime?   @map("valid_until")
  deliveryTerms String?     @map("delivery_terms")
  paymentTerms  String?     @map("payment_terms")
  notes         String?
  items         QuoteItem[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String  @map("quote_id")
  description String
  unit        String  @default("st")
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  costPrice   Decimal @default(0) @map("cost_price") @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("quote_items")
}

model DeliveryEvent {
  id           String   @id @default(cuid())
  type         String
  date         DateTime
  time         String?
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String   @map("project_id")
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   String   @map("customer_id")
  address      String?
  notes        String?
  reminderSent Boolean  @default(false) @map("reminder_sent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("delivery_events")
}

model Partner {
  id            String           @id @default(cuid())
  companyName   String           @map("company_name")
  contactPerson String?          @map("contact_person")
  email         String?
  phone         String?
  category      String
  notes         String?
  projects      ProjectPartner[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("partners")
}

model ProjectPartner {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String  @map("partner_id")
  role      String?
  notes     String?

  @@unique([projectId, partnerId])
  @@map("project_partners")
}

model Activity {
  id                  String    @id @default(cuid())
  type                String    @default("anteckning")
  title               String?
  description         String
  status              String    @default("oppen")
  dueDate             DateTime? @map("due_date")
  customer            Customer? @relation(fields: [customerId], references: [id])
  customerId          String?   @map("customer_id")
  project             Project?  @relation(fields: [projectId], references: [id])
  projectId           String?   @map("project_id")
  unlinkedCustomerText String?  @map("unlinked_customer_text")
  assignedTo          User?     @relation("AssignedActivities", fields: [assignedToId], references: [id])
  assignedToId        String?   @map("assigned_to_id")
  createdBy           User      @relation("CreatedActivities", fields: [createdById], references: [id])
  createdById         String    @map("created_by_id")
  relatedActivity     Activity? @relation("RelatedActivities", fields: [relatedActivityId], references: [id])
  relatedActivityId   String?   @map("related_activity_id")
  childActivities     Activity[] @relation("RelatedActivities")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("activities")
}
